# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# CONFIGURATION SERVEUR AUTONOME (DOCKER / VM FREEBOX / MULTI-MAGASINS)
# ==============================================================================
# Port d'écoute du serveur
PORT="3000"
NODE_ENV="production"

# ==============================================================================
# MOT DE PASSE SUPER-ADMINISTRATEUR (Espace Gestionnaire Multi-Magasins)
# ==============================================================================
# Ce mot de passe protège l'accès à l'Espace Gestionnaire Multi-Magasins.
SUPER_ADMIN_PASSWORD="VOTRE_MOT_DE_PASSE_GESTIONNAIRE_ICI"
