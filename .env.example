# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# CONFIGURATION SERVEUR AUTONOME (DOCKER / VM FREEBOX / MULTI-MAGASINS)
# ==============================================================================
# Port d'écoute du serveur
PORT="3000"
NODE_ENV="production"

# ==============================================================================
# MOT DE PASSE SUPER-ADMINISTRATEUR (Espace Gestionnaire Multi-Magasins)
# ==============================================================================
# Ce mot de passe protège l'accès à l'Espace Gestionnaire Multi-Magasins.
SUPER_ADMIN_PASSWORD="VOTRE_MOT_DE_PASSE_GESTIONNAIRE_ICI"

# ==============================================================================
# MODULE IA DE PLANNING (option activée magasin par magasin dans l'Espace Gestionnaire)
# ==============================================================================
# Modèle par défaut : "gemini" (offre gratuite possible) ou "anthropic" (Claude), pour un magasin dont le gestionnaire n'a rien choisi.
# Le gestionnaire autorise un ou deux modèles par magasin ; l'administrateur du magasin choisit parmi eux. Une clé par modèle ci-dessous.
AI_PROVIDER="gemini"

# Gemini — clé gratuite sur https://aistudio.google.com/apikey
# ATTENTION : avec l'offre GRATUITE, Google peut utiliser les échanges pour améliorer ses produits.
# (les prénoms sont déjà remplacés par « Salarié A, B… » avant l'envoi, mais le planning reste transmis)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Nom du modèle : à vérifier dans Google AI Studio (les noms changent régulièrement ; un modèle "Flash" convient).
GEMINI_MODEL="gemini-3.8-flash"

# Claude (si AI_PROVIDER="anthropic")
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"

# Nombre maximum de générations PAR MAGASIN ET PAR HEURE (protège votre quota / votre budget). Défaut : 10.
AI_MAX_GENERATIONS_PER_HOUR="10"
# Durée maximale d'attente de la réponse de l'IA, en secondes. Défaut : 120.
AI_TIMEOUT_SECONDS="120"
