+++ b/tests/generation.test.mjs
@@ -0,0 +1,165 @@
+// Tests d'intégration serveur — usage : node tests/generation.test.mjs [url] [store.json]
+import { readFileSync, existsSync } from 'fs';
+
+const BASE = process.argv[2] || 'http://localhost:3100';
+const DATA = process.argv[3];
+const SUPER_PW = process.env.SUPER_ADMIN_PASSWORD || 'test-admin';
+
+let pass = 0, fail = 0;
+const t = (name, ok, detail = '') => { ok ? pass++ : fail++; console.log(`${ok ? 'OK   ' : 'ECHEC'}  ${name}${detail ? '  → ' + detail : ''}`); };
+async function call(method, path, { body, headers = {} } = {}) {
+  const r = await fetch(BASE + path, { method, headers: { 'Content-Type': 'application/json', ...headers }, body: body !== undefined ? JSON.stringify(body) : undefined });
+  let json = null; try { json = await r.json(); } catch {}
+  return { status: r.status, json };
+}
+
+// ---- calendrier de référence INDÉPENDANT du code testé -----------------------------------------
+const easter = (y) => { const a = y % 19, b = Math.floor(y / 100), c = y % 100, d = Math.floor(b / 4), e = b % 4, f = Math.floor((b + 8) / 25), g = Math.floor((b - f + 1) / 3), h = (19 * a + b - d - g + 15) % 30, i = Math.floor(c / 4), k = c % 4, l = (32 + 2 * e + 2 * i - h - k) % 7, m = Math.floor((a + 11 * h + 22 * l) / 451); return new Date(Date.UTC(y, Math.floor((h + l - 7 * m + 114) / 31) - 1, ((h + l - 7 * m + 114) % 31) + 1)); };
+const iso = (dt) => dt.toISOString().slice(0, 10);
+const holidays = (y) => { const e = easter(y).getTime(), p = (n) => iso(new Date(e + n * 864e5)); return new Set([`${y}-01-01`, p(1), `${y}-05-01`, `${y}-05-08`, p(39), p(50), `${y}-07-14`, `${y}-08-15`, `${y}-11-01`, `${y}-11-11`, `${y}-12-25`]); };
+const expectedCode = (dk) => { if (holidays(+dk.slice(0, 4)).has(dk)) return 'FERIE'; const w = new Date(dk + 'T00:00:00Z').getUTCDay(); return w === 0 || w === 6 ? 'REPOS' : 'BASE'; };
+const datesOf = (m) => { const [y, mo] = m.split('-').map(Number); const n = new Date(Date.UTC(y, mo, 0)).getUTCDate(); return Array.from({ length: n }, (_, i) => `${m}-${String(i + 1).padStart(2, '0')}`); };
+const nowKey = () => { const n = new Date(); return `${n.getFullYear()}-${String(n.getMonth() + 1).padStart(2, '0')}`; };
+const monthConforms = (days, m) => datesOf(m).every((d) => days?.[d]?.shift === expectedCode(d));
+
+// ---- préparation : magasin neuf -------------------------------------------------------------------
+const login = await call('POST', '/api/superadmin/login', { body: { password: SUPER_PW } });
+const SA = { 'X-Superadmin-Token': login.json?.token };
+const created = await call('POST', '/api/superadmin/stores', { body: { name: 'Magasin Génération', token: 'GEN-TEST', adminPin: '112233' }, headers: SA });
+const store = created.json?.store;
+const v = await call('POST', '/api/verify-token', { body: { token: 'GEN-TEST' } });
+const SH = { Authorization: `Bearer ${v.json.session}`, 'X-Store-Id': store.id };
+const pin = await call('POST', '/api/verify-pin', { headers: SH, body: { pin: '112233' } });
+const AH = { ...SH, 'X-Admin-Session': pin.json.adminSession };
+const schedules = async () => (await call('GET', '/api/schedules', { headers: SH })).json.schedules;
+const config = async () => (await call('GET', '/api/config', { headers: SH })).json.config;
+
+// ---- 1. Création d'un magasin -------------------------------------------------------------------
+let cfg = await config();
+const firstEmployee = cfg.employees[0];
+t('catégories par défaut = les 6 catégories de base', JSON.stringify(cfg.categories.map((c) => c.name)) === JSON.stringify(['BASE', 'REPOS', 'RTT', 'FERIE', 'CFA', 'CONGES']));
+t('les 12 mois de l\'exercice sont visibles', cfg.visibleMonths.length === 12 && cfg.allMonths.length === 12);
+let sc = await schedules();
+const months0 = cfg.allMonths.map((m) => m.key);
+t('planning du responsable généré et enregistré pour les 12 mois', months0.every((m) => sc[m]?.[firstEmployee.name]));
+t('chaque journée = FERIE / REPOS / BASE selon le calendrier', months0.every((m) => monthConforms(sc[m][firstEmployee.name].days, m)));
+const janKey = months0.find((m) => m.endsWith('-01'));
+const wantJan = datesOf(janKey).filter((d) => expectedCode(d) === 'BASE').length * 7;
+t(`total du mois enregistré correct (${janKey} : ${wantJan} h)`, sc[janKey][firstEmployee.name].totalHours === wantJan, `obtenu ${sc[janKey][firstEmployee.name].totalHours}`);
+const febKey = months0.find((m) => m.endsWith('-02'));
+t('février : nombre de jours exact', Object.keys(sc[febKey][firstEmployee.name].days).length === datesOf(febKey).length, `${Object.keys(sc[febKey][firstEmployee.name].days).length} jours`);
+
+// ---- 2. Ajout d'un salarié ---------------------------------------------------------------------
+const before = JSON.stringify(sc);
+const newEmp = { ...firstEmployee, name: 'Nouveau', role: 'Test', isAdmin: false };
+let r = await call('POST', '/api/config', { headers: AH, body: { employees: [...cfg.employees, newEmp] } });
+t('ajout du salarié accepté', r.status === 200);
+sc = await schedules();
+const fromNow = months0.filter((m) => m >= nowKey());
+const pastMonths = months0.filter((m) => m < nowKey());
+t(`planning généré du mois courant à la fin de l'exercice (${fromNow.length} mois)`, fromNow.every((m) => monthConforms(sc[m]?.['Nouveau']?.days, m)));
+t(`mois passés NON générés automatiquement (${pastMonths.length} mois)`, pastMonths.every((m) => !sc[m]?.['Nouveau']));
+t('les autres salariés ne sont pas modifiés', JSON.stringify(Object.fromEntries(months0.map((m) => [m, sc[m][firstEmployee.name]]))) === JSON.stringify(Object.fromEntries(months0.map((m) => [m, JSON.parse(before)[m][firstEmployee.name]]))));
+
+// ---- 3. Idempotence + reprise ------------------------------------------------------------------
+const g1 = await call('POST', '/api/planning/generate', { headers: AH, body: {} });
+t('relancer la génération : 0 journée créée', g1.json?.createdDays === 0, `créées=${g1.json?.createdDays}`);
+if (pastMonths.length) {
+  const g2 = await call('POST', '/api/planning/generate', { headers: AH, body: { monthKeys: pastMonths, employeeNames: ['Nouveau'] } });
+  t('génération explicite sur les mois passés (reprise)', g2.json?.createdDays === pastMonths.reduce((n, m) => n + datesOf(m).length, 0));
+  const g3 = await call('POST', '/api/planning/generate', { headers: AH, body: { monthKeys: pastMonths, employeeNames: ['Nouveau'] } });
+  t('…et une seconde fois : 0 journée', g3.json?.createdDays === 0);
+}
+r = await call('POST', '/api/planning/generate', { headers: SH, body: {} });
+t('génération sans droits administrateur refusée', r.status === 403);
+
+// ---- 4. Protection des saisies ---------------------------------------------------------------------
+const m4 = fromNow[0] || months0[months0.length - 1];
+const monday = datesOf(m4).find((d) => expectedCode(d) === 'BASE');
+const mondayHours = (await schedules())[m4]['Nouveau'].totalHours;
+await call('POST', `/api/schedules/${m4}/shift`, { headers: AH, body: { employeeName: 'Nouveau', dateKey: monday, shift: 'CONGES', hours: '', info: 'saisie manuelle' } });
+await call('POST', '/api/planning/generate', { headers: AH, body: { monthKeys: [m4] } });
+sc = await schedules();
+t('saisie manuelle jamais écrasée par une génération', sc[m4]['Nouveau'].days[monday].shift === 'CONGES' && sc[m4]['Nouveau'].days[monday].info === 'saisie manuelle');
+t('total recalculé après la saisie (-7 h)', sc[m4]['Nouveau'].totalHours === mondayHours - 7, `${mondayHours} -> ${sc[m4]['Nouveau'].totalHours}`);
+await call('POST', `/api/schedules/${m4}/shift`, { headers: AH, body: { employeeName: 'Nouveau', dateKey: monday, shift: 'EMPTY', hours: '' } });
+await call('POST', '/api/planning/generate', { headers: AH, body: { monthKeys: [m4] } });
+sc = await schedules();
+t('journée supprimée (absente) : recréée par la reprise', sc[m4]['Nouveau'].days[monday]?.shift === 'BASE');
+
+// ---- 5. Ajout d'un mois (février bissextile) -------------------------------------------------------
+cfg = await config();
+const other = JSON.stringify((await schedules())[months0[0]]);
+const feb28 = { key: '2028-02', tab: 'FEVRIER 28', label: 'Février 2028' };
+r = await call('POST', '/api/config', { headers: AH, body: { allMonths: [...cfg.allMonths, feb28], visibleMonths: [...cfg.visibleMonths, '2028-02'] } });
+sc = await schedules();
+const emps = cfg.employees.map((e) => e.name).concat('Nouveau');
+t('mois ajouté : généré pour TOUS les salariés (29 jours en 2028)', emps.every((n) => Object.keys(sc['2028-02']?.[n]?.days || {}).length === 29 && monthConforms(sc['2028-02'][n].days, '2028-02')));
+t('les mois existants ne sont pas modifiés', JSON.stringify(sc[months0[0]]) === other);
+
+// ---- 6. Nouvel exercice -------------------------------------------------------------------------------
+cfg = await config();
+const ex27 = ['2027-06', '2027-07', '2027-08', '2027-09', '2027-10', '2027-11', '2027-12', '2028-01', '2028-02', '2028-03', '2028-04', '2028-05'];
+const items = ex27.filter((k) => !cfg.allMonths.some((m) => m.key === k)).map((k) => ({ key: k, tab: k, label: k }));
+const beforeMonths = JSON.stringify(Object.fromEntries(months0.map((m) => [m, sc[m]])));
+r = await call('POST', '/api/config', { headers: AH, body: { allMonths: [...cfg.allMonths, ...items], visibleMonths: [...cfg.visibleMonths, ...items.map((i) => i.key)] } });
+sc = await schedules();
+t('nouvel exercice : 12 mois (juin→mai) générés pour tous les salariés', ex27.every((m) => emps.every((n) => monthConforms(sc[m]?.[n]?.days, m))));
+t('exercice précédent intact', JSON.stringify(Object.fromEntries(months0.map((m) => [m, sc[m]]))) === beforeMonths);
+
+// ---- 7. Concurrence / doubles clics ------------------------------------------------------------------
+cfg = await config();
+const m7 = { key: '2030-03', tab: 'MARS 30', label: 'Mars 2030' };
+const cfgBody = { allMonths: [...cfg.allMonths, m7], visibleMonths: [...cfg.visibleMonths, '2030-03'] };
+const results = await Promise.all([1, 2, 3, 4, 5].map(() => call('POST', '/api/config', { headers: AH, body: cfgBody })));
+await Promise.all([1, 2, 3].map(() => call('POST', '/api/planning/generate', { headers: AH, body: { monthKeys: ['2030-03'] } })));
+sc = await schedules();
+t('5 envois simultanés : tous acceptés', results.every((x) => x.status === 200));
+t('…journées uniques et complètes (31 jours, aucun doublon)', emps.every((n) => Object.keys(sc['2030-03'][n].days).length === 31 && monthConforms(sc['2030-03'][n].days, '2030-03')));
+t('…mois ajouté une seule fois dans la config', (await config()).allMonths.filter((m) => m.key === '2030-03').length === 1);
+
+// ---- 8. Totaux jamais périmés + aucun salarié perdu --------------------------------------------------
+const mTot = months0[months0.length - 2];
+sc = await schedules();
+const stale = JSON.parse(JSON.stringify(sc[mTot]));
+const someDay = datesOf(mTot).find((d) => expectedCode(d) === 'BASE');
+stale[firstEmployee.name].days[someDay] = { shift: 'RTT', hours: '', info: '' };
+stale[firstEmployee.name].totalHours = 999; // total périmé envoyé par un vieux client
+delete stale['Nouveau']; // client pas encore synchronisé
+await call('POST', `/api/schedules/${mTot}`, { headers: AH, body: { teamSchedules: stale } });
+sc = await schedules();
+const exp = datesOf(mTot).reduce((n, d) => n + (d === someDay ? 0 : expectedCode(d) === 'BASE' ? 7 : 0), 0);
+t('total périmé corrigé par le serveur', sc[mTot][firstEmployee.name].totalHours === exp, `obtenu ${sc[mTot][firstEmployee.name].totalHours}, attendu ${exp}`);
+t('salarié absent de l\'envoi conservé', !!sc[mTot]['Nouveau']);
+
+// ---- 9. Catégories verrouillées côté serveur ----------------------------------------------------------
+r = await call('POST', '/api/config', { headers: AH, body: { categories: [{ id: 'x', name: 'REPOS', color: 'rose' }, { id: 'c1', name: 'INVENTAIRE', color: 'sky' }], tableau2Shifts: [{ id: 'inv', shift: 'INVENTAIRE', hours: '', category: 'INVENTAIRE', label: 'INVENTAIRE', hoursDecimal: 4 }] } });
+cfg = await config();
+t('catégories de base impossibles à supprimer ou modifier', JSON.stringify(cfg.categories.slice(0, 6).map((c) => c.name)) === JSON.stringify(['BASE', 'REPOS', 'RTT', 'FERIE', 'CFA', 'CONGES']) && cfg.categories.find((c) => c.name === 'REPOS').color === 'slate' && cfg.categories.every((c) => c.name !== 'BASE' || c.locked));
+t('catégorie personnalisée créée et conservée', cfg.categories.some((c) => c.name === 'INVENTAIRE') && cfg.tableau2Shifts.some((o) => o.shift === 'INVENTAIRE'));
+r = await call('POST', '/api/config', { headers: AH, body: { categories: cfg.categories.filter((c) => c.name !== 'INVENTAIRE'), tableau2Shifts: cfg.tableau2Shifts.filter((o) => o.shift !== 'INVENTAIRE') } });
+cfg = await config();
+t('catégorie personnalisée supprimable', !cfg.categories.some((c) => c.name === 'INVENTAIRE') && cfg.categories.length === 6);
+
+// ---- 10. Données réelles : option A (aucune réinitialisation) ----------------------------------------------
+if (DATA && existsSync(DATA)) {
+  const real = JSON.parse(readFileSync(DATA, 'utf8'));
+  r = await call('POST', '/api/backup', { headers: AH, body: real });
+  t('restauration des vraies données (copie isolée)', r.status === 200);
+  const after = await schedules();
+  const identical = JSON.stringify(Object.keys(real.schedules).sort()) === JSON.stringify(Object.keys(after).sort()) &&
+    Object.keys(real.schedules).every((m) => JSON.stringify(real.schedules[m]) === JSON.stringify(after[m]));
+  t('plannings réels strictement identiques après migration (aucune journée ajoutée/modifiée/supprimée)', identical);
+  const c2 = await config();
+  const legacy = real.config.categories.map((c) => c.name).filter((n) => !['BASE', 'REPOS', 'RTT', 'FERIE', 'CFA', 'CONGES'].includes(n));
+  t('catégories réelles : 6 de base + anciennes conservées comme personnalisées', JSON.stringify(c2.categories.map((c) => c.name)) === JSON.stringify(['BASE', 'REPOS', 'RTT', 'FERIE', 'CFA', 'CONGES', ...legacy]), c2.categories.map((c) => c.name).join(','));
+  t('créneaux réels (OUVERTURE, FERMETURE…) conservés', ['OUVERTURE', 'FERMETURE', 'JOURNEE'].every((s) => c2.tableau2Shifts.some((o) => o.shift === s)));
+  t('12 mois visibles conservés', c2.visibleMonths.length === 12);
+  const dry = await call('POST', '/api/planning/generate', { headers: AH, body: {} });
+  console.log(`INFO  une génération manuelle (mois courant → fin d'exercice) créerait ${dry.json.createdDays} journée(s) manquante(s) sur vos données réelles — jamais lancée automatiquement`);
+}
+
+// ---- nettoyage -----------------------------------------------------------------------------------------------
+await call('DELETE', `/api/superadmin/stores/${store.id}`, { headers: SA });
+console.log(`\nRésultat : ${pass} OK, ${fail} échec(s)`);
+process.exit(fail ? 1 : 0);
diff --git a/tests/regression-real-data.mjs b/tests/regression-real-data.mjs
new file mode 100644
index 0000000..49c86a6
--- /dev/null
+++ b/tests/regression-real-data.mjs
@@ -0,0 +1,41 @@
+// Compare l'ANCIEN et le NOUVEAU code de calcul sur les vraies données (copie sans secrets).
+// Usage : BASE_URL=/ bun run tests/regression-real-data.mjs <store.json> <dossier-ancien-code>
+import { readFileSync } from 'fs';
+const [dataPath, oldDir] = [process.argv[2], process.argv[3]];
+const mem = new Map();
+globalThis.localStorage = { getItem: (k) => (mem.has(k) ? mem.get(k) : null), setItem: (k, v) => void mem.set(k, String(v)), removeItem: (k) => void mem.delete(k), clear: () => mem.clear() };
+globalThis.window = Object.assign(new EventTarget(), { localStorage });
+
+const d = JSON.parse(readFileSync(dataPath, 'utf8'));
+for (const [m, sc] of Object.entries(d.schedules)) mem.set(`planning_team_${m}`, JSON.stringify(sc));
+
+const oldMod = await import(`${oldDir}/src/services/hoursService.ts`);
+const newMod = await import('../src/services/hoursService.ts');
+const { isOpenWeekday } = await import('../src/shared/planning.ts');
+
+const FIELDS = ['monthHours', 'expectedMonthHours', 'monthBalance', 'monthWorkedDays', 'exerciseHours', 'expectedExerciseHoursAtDate', 'exerciseBalance', 'projectedExerciseEndHours', 'exerciseWorkedDays', 'forfaitDaysRemaining', 'paidLeaveTaken', 'paidLeaveRemaining', 'rttTaken', 'rttRemaining', 'initialHoursBalance'];
+const months = d.config.allMonths;
+let pairs = 0, diffPairs = 0, unexplained = 0;
+const byField = {};
+const lines = [];
+for (const emp of d.config.employees) for (const mi of months) {
+  const sched = d.schedules[mi.key]?.[emp.name];
+  const params = { employee: emp, selectedMonth: mi.key, currentSchedule: sched || null, teamSchedules: d.schedules[mi.key] || {}, allMonths: months };
+  const a = oldMod.calculateEmployeeBalances(params), b = newMod.calculateEmployeeBalances(params);
+  pairs++;
+  const diffs = FIELDS.filter((f) => JSON.stringify(a[f]) !== JSON.stringify(b[f]));
+  if (!diffs.length) continue;
+  diffPairs++;
+  diffs.forEach((f) => (byField[f] = (byField[f] || 0) + 1));
+  // Explication attendue : jours CFA dans le mois (objectif) ou dans l'exercice (compteur RTT)
+  const cfaMonth = sched ? Object.entries(sched.days || {}).filter(([k, v]) => (v.shift || '').toUpperCase() === 'CFA' && isOpenWeekday(k)).length : 0;
+  const cfaAny = Object.values(d.schedules).some((m) => Object.values(m[emp.name]?.days || {}).some((v) => (v.shift || '').toUpperCase() === 'CFA'));
+  if (!cfaAny) unexplained++;
+  if (lines.length < 12) lines.push(`${emp.name} ${mi.key}: ` + diffs.map((f) => `${f} ${a[f]}→${b[f]}`).join(', ') + ` (jours CFA ouvrés du mois: ${cfaMonth})`);
+}
+console.log(`Couples salarié×mois comparés : ${pairs}`);
+console.log(`Avec au moins une différence    : ${diffPairs}`);
+console.log(`Différences sans aucun jour CFA  : ${unexplained}  (doit être 0)`);
+console.log('Champs concernés :', JSON.stringify(byField));
+console.log(lines.join('\n'));
+process.exit(unexplained ? 1 : 0);
diff --git a/tests/rules.test.mjs b/tests/rules.test.mjs
new file mode 100644
index 0000000..29260f8
--- /dev/null
+++ b/tests/rules.test.mjs
@@ -0,0 +1,134 @@
+// Tests des règles métier — usage : BASE_URL=/ bun run tests/rules.test.mjs [store.json]
+import { readFileSync, existsSync } from 'fs';
+
+const mem = new Map();
+globalThis.localStorage = { getItem: (k) => (mem.has(k) ? mem.get(k) : null), setItem: (k, v) => void mem.set(k, String(v)), removeItem: (k) => void mem.delete(k), clear: () => mem.clear() };
+globalThis.window = Object.assign(new EventTarget(), { localStorage });
+
+const P = await import('../src/shared/planning.ts');
+const H = await import('../src/services/hoursService.ts');
+const C = await import('../src/config/constants.ts');
+const { calculateShiftDurationHours } = await import('../src/server/db.ts');
+const { ensureCoreConfig } = await import('../src/shared/coreConfig.ts');
+
+let pass = 0, fail = 0;
+const eq = (name, got, want) => {
+  const ok = JSON.stringify(got) === JSON.stringify(want);
+  ok ? pass++ : fail++;
+  console.log(`${ok ? 'OK   ' : 'ECHEC'}  ${name}${ok ? '' : `  → attendu ${JSON.stringify(want)}, obtenu ${JSON.stringify(got)}`}`);
+};
+
+// ---- 1. Heures des catégories de base (client ET serveur) -----------------------------------
+const opts = C.DEFAULT_TABLEAU2_SHIFTS;
+for (const [code, h] of [['BASE', 7], ['REPOS', 0], ['RTT', 0], ['CFA', 0], ['CONGES', 0], ['FERIE', 0]]) {
+  eq(`${code} = ${h} h (client)`, H.parseWorkedHours(code, ''), h);
+  eq(`${code} = ${h} h (serveur)`, calculateShiftDurationHours(code, '', opts), h);
+}
+for (const c of ['HEBDO_35H', 'ANNUALISE', 'FORFAIT_JOUR'])
+  eq(`BASE = 7 h pour le contrat ${c}`, H.parseWorkedHours('BASE', '', c), 7);
+eq('BASE ignore un horaire saisi (7 h quand même)', H.parseWorkedHours('BASE', '09:00-12:00', 'HEBDO_35H'), 7);
+eq('CFA distinct de RTT (catégorie)', [C.categorizeShift('CFA'), C.categorizeShift('RTT')], ['CFA', 'RTT']);
+eq('BASE est une catégorie à part', C.categorizeShift('BASE'), 'BASE');
+
+// ---- 2. Jours fériés : dates calculées indépendamment (calendriers officiels) ----------------
+const known = {
+  2024: ['2024-04-01', '2024-05-09', '2024-05-20'],
+  2025: ['2025-04-21', '2025-05-29', '2025-06-09'],
+  2026: ['2026-04-06', '2026-05-14', '2026-05-25'],
+  2027: ['2027-03-29', '2027-05-06', '2027-05-17'],
+  2028: ['2028-04-17', '2028-05-25', '2028-06-05'],
+};
+for (const [y, [paques, ascension, pentecote]] of Object.entries(known)) {
+  const h = P.getFrenchPublicHolidays(Number(y));
+  eq(`${y} : lundi de Pâques, Ascension, lundi de Pentecôte`, [!!h[paques], !!h[ascension], !!h[pentecote]], [true, true, true]);
+  eq(`${y} : 11 jours fériés`, Object.keys(h).length, 11);
+}
+
+// ---- 3. Calendrier : longueur des mois ---------------------------------------------------------
+eq('février 2027 = 28 jours', P.getMonthDateKeys('2027-02').length, 28);
+eq('février 2028 (bissextile) = 29 jours', P.getMonthDateKeys('2028-02').length, 29);
+eq('novembre 2026 = 30 jours', P.getMonthDateKeys('2026-11').length, 30);
+eq('décembre 2026 = 31 jours', P.getMonthDateKeys('2026-12').length, 31);
+eq('mois invalide = aucune date', P.getMonthDateKeys('2026-13').length, 0);
+
+// ---- 4. Génération d'une journée --------------------------------------------------------------
+const code = (d) => P.generateDefaultDay(d).shift;
+eq('lundi ordinaire (2026-11-09) -> BASE', code('2026-11-09'), 'BASE');
+eq('samedi ordinaire (2026-11-07) -> REPOS', code('2026-11-07'), 'REPOS');
+eq('dimanche ordinaire (2026-11-08) -> REPOS', code('2026-11-08'), 'REPOS');
+eq('férié en semaine (2026-11-11, mercredi) -> FERIE', code('2026-11-11'), 'FERIE');
+eq('férié un dimanche (2026-11-01 Toussaint) -> FERIE prioritaire', code('2026-11-01'), 'FERIE');
+eq('férié un samedi (2027-05-08) -> FERIE prioritaire', code('2027-05-08'), 'FERIE');
+eq('lundi de Pâques 2027-03-29 -> FERIE', code('2027-03-29'), 'FERIE');
+eq('Ascension 2027-05-06 -> FERIE', code('2027-05-06'), 'FERIE');
+eq('lundi de Pentecôte 2027-05-17 -> FERIE', code('2027-05-17'), 'FERIE');
+eq('29 février 2028 (mardi) -> BASE', code('2028-02-29'), 'BASE');
+eq('31 mai -> 1er juin : exercice change', [P.getExerciseStartYear('2027-05'), P.getExerciseStartYear('2027-06')], [2026, 2027]);
+eq('exercice 2026 = 12 mois juin→mai', [P.getExerciseMonthKeys(2026)[0], P.getExerciseMonthKeys(2026)[11], P.getExerciseMonthKeys(2026).length], ['2026-06', '2027-05', 12]);
+eq('exercice 2027 : même règle sans toucher au code', P.getExerciseMonthKeys(2027)[0], '2027-06');
+eq('libellés/onglets du mois', P.buildMonthItem('2027-02'), { key: '2027-02', tab: 'FEVRIER 27', label: 'Février 2027' });
+eq('12 mois visibles par défaut', C.DEFAULT_VISIBLE_MONTHS.length, 12);
+
+// ---- 5. Catégories de base verrouillées ---------------------------------------------------------
+eq('6 catégories de base par défaut', C.DEFAULT_CATEGORIES.map((c) => c.name), ['BASE', 'REPOS', 'RTT', 'FERIE', 'CFA', 'CONGES']);
+eq('toutes verrouillées', C.DEFAULT_CATEGORIES.every((c) => c.locked) && C.DEFAULT_TABLEAU2_SHIFTS.every((o) => o.locked), true);
+const migrated = ensureCoreConfig({
+  categories: [{ id: 'x', name: 'REPOS', color: 'rose' }, { id: 'cat_matin', name: 'MATIN', color: 'sky' }],
+  tableau2Shifts: [{ id: 'o1', shift: 'OUVERTURE', hours: '09:00-12:00', category: 'JOURNEE', label: 'OUVERTURE' }, { id: 'repos', shift: 'REPOS', hours: '', category: 'REPOS', label: 'REPOS modifié' }],
+});
+eq('migration : 6 catégories de base en tête, personnalisées conservées', migrated.categories.map((c) => c.name), ['BASE', 'REPOS', 'RTT', 'FERIE', 'CFA', 'CONGES', 'MATIN']);
+eq('migration : créneau personnalisé conservé, base rétablie', [migrated.tableau2Shifts.some((o) => o.shift === 'OUVERTURE'), migrated.tableau2Shifts.find((o) => o.shift === 'REPOS').label], [true, 'REPOS']);
+eq('migration idempotente', ensureCoreConfig(migrated).changed, false);
+
+// ---- 6. CFA : 0 h travaillée, -7 h sur l'objectif mensuel -------------------------------------
+const emp = { name: 'Test', role: 'x', contractType: 'HEBDO_35H', weeklyHoursQuota: 35 };
+const mk = (days) => ({ employee: 'Test', month: '2027-01', days, totalHours: 0 });
+const all = P.getMonthDateKeys('2027-01');
+const baseDays = Object.fromEntries(all.map((d) => [d, P.generateDefaultDay(d)]));
+const calc = (days) => H.calculateEmployeeBalances({ employee: emp, selectedMonth: '2027-01', currentSchedule: mk(days), teamSchedules: { Test: mk(days) } });
+const b0 = calc(baseDays);
+eq('janvier 2027 généré : 140 h travaillées, objectif 140 h, solde 0', [b0.monthHours, b0.expectedMonthHours, b0.monthBalance], [140, 140, 0]);
+const withCfa = { ...baseDays, '2027-01-12': { shift: 'CFA', hours: '', info: '' }, '2027-01-13': { shift: 'CFA', hours: '', info: '' } };
+const b1 = calc(withCfa);
+eq('2 jours CFA : 126 h travaillées, objectif 126 h (-14 h), solde 0', [b1.monthHours, b1.expectedMonthHours, b1.monthBalance, b1.monthCfaDays], [126, 126, 0, 2]);
+const cfaWeekend = { ...baseDays, '2027-01-09': { shift: 'CFA', hours: '', info: '' }, '2027-01-01': { shift: 'CFA', hours: '', info: '' } };
+const b2 = calc(cfaWeekend);
+eq('CFA un samedi ou un jour férié : pas de double déduction', [b2.expectedMonthHours, b2.monthCfaDays], [140, 0]);
+const withRtt = { ...baseDays, '2027-01-12': { shift: 'RTT', hours: '', info: '' } };
+const b3 = calc(withRtt);
+eq('RTT : comportement actuel conservé (0 h, objectif inchangé)', [b3.monthHours, b3.expectedMonthHours, b3.rttTaken], [133, 140, 1]);
+eq('CFA ne compte pas dans les RTT pris', b1.rttTaken, 0);
+const withCp = { ...baseDays, '2027-01-12': { shift: 'CONGES', hours: '', info: '' } };
+eq('CONGES : comportement actuel conservé (objectif -7 h)', calc(withCp).expectedMonthHours, 133);
+
+// ---- 7. Soldes initiaux : propres à chaque exercice ------------------------------------------
+const empInit = { ...emp, contractType: 'ANNUALISE', initialHoursBalance: 3.5 };
+const bal = (m) => H.calculateEmployeeBalances({ employee: empInit, selectedMonth: m, currentSchedule: null, teamSchedules: {} });
+eq('solde initial appliqué à l\'exercice 2026-27', bal('2026-10').initialHoursBalance, 3.5);
+eq('solde initial NON reporté sur l\'exercice 2027-28', bal('2027-09').initialHoursBalance, 0);
+
+// ---- 8. Cohérence client / serveur sur les vraies données ------------------------------------
+const dataPath = process.argv[2];
+if (dataPath && existsSync(dataPath)) {
+  const d = JSON.parse(readFileSync(dataPath, 'utf8'));
+  const pairs = new Set();
+  for (const m of Object.values(d.schedules)) for (const s of Object.values(m)) for (const day of Object.values(s.days || {})) pairs.add(`${day.shift}||${day.hours}`);
+  let mismatch = [];
+  for (const k of pairs) {
+    const [shift, hours] = k.split('||');
+    const a = H.parseWorkedHours(shift, hours, undefined);
+    const b = Math.round(calculateShiftDurationHours(shift, hours, d.config.tableau2Shifts) * 100) / 100;
+    if (Math.abs(a - b) > 0.06) mismatch.push(`${shift} [${hours}] client=${a} serveur=${b}`);
+  }
+  eq(`client = serveur sur ${pairs.size} combinaisons réelles`, mismatch, []);
+  // Les 6 catégories de base : jamais d'écart sur toutes les données
+  let stale = 0;
+  for (const [m, sc] of Object.entries(d.schedules)) for (const [n, s] of Object.entries(sc)) {
+    let t = 0; for (const day of Object.values(s.days || {})) t += H.parseWorkedHours(day.shift, day.hours, undefined);
+    if (Math.abs(Math.round(t * 100) / 100 - (s.totalHours ?? 0)) > 0.06) stale++;
+  }
+  eq('totaux enregistrés = recalcul (72 plannings réels)', stale, 0);
+}
+
+console.log(`\nRésultat : ${pass} OK, ${fail} échec(s)`);
+process.exit(fail ? 1 : 0);
